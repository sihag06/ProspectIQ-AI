# Copy this file to .env and fill in your keys. Never commit .env.

# AI providers: add at least one. Providers without a key are hidden in the app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web search (required)
TAVILY_API_KEY=

# Optional: keep cached search results indefinitely, for reliable demos
# PROSPECTIQ_DEMO_MODE=1
